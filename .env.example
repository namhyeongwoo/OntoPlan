# OpenAI API key (required): GPT-4o agents and category embeddings
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# LangSmith tracing (optional): https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=OntoPlan

# Optional: pin the GPT-4o snapshot and tune retries (see experiments/README.md)
# ONTOPLAN_MODEL=gpt-4o-2024-08-06
# OPENAI_MAX_RETRIES=10
# OPENAI_TIMEOUT=120
